# Coverage configuration
[run]
source = .
omit = 
    */venv/*
    */env/*
    */migrations/*
    */tests/*
    */test_*
    */__pycache__/*
    */node_modules/*
    manage.py
    */settings/*
    */conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

show_missing = True
skip_covered = True
precision = 2

[html]
directory = htmlcov
